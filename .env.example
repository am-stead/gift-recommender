# Environment Variables for Gift Recommender

# OpenAI API Key - Required for gift idea generation
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Set to 'development' for debug mode
# APP_ENV=development

# Optional: Custom database path (defaults to gift_recommendations.db)
# DATABASE_PATH=custom_path_to_database.db